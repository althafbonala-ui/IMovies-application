# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# Local MongoDB Connection String (imovies database)
MONGO_URI=mongodb://127.0.0.1:27017/imovies

# JWT Secret for future authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Email Service Configuration (Nodemailer SMTP)
# For real delivery, configure your SMTP server details (e.g., Gmail with App Password, Mailtrap, etc.)
# If unconfigured or left as placeholders, iMovies safely operates in development preview mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM="iMovies Cinemas" <your-email@gmail.com>
